# ChainPilot Environment Variables Template
# Copy this file to .env.local for local development

# Groq AI Engine Configuration (Primary)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Google Gemini AI Engine Configuration (Fallback)
GEMINI_API_KEY="your_gemini_api_key_here"

# The Graph Subgraph API Key
THE_GRAPH_API_KEY="your_the_graph_api_key_here"

# Privy Auth Configuration
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id_here"
